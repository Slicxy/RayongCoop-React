# Environment variables
.env
.env.backup
.env.production

# Composer dependencies
/vendor/

# Storage & Temporary files
/storage/logs/*.log
/storage/backups/*.sql
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep

# Public uploads (member PII documents — never track)
/public/uploads/*
!/public/uploads/.gitkeep
/public/uploads/**/*
!/public/uploads/**/.gitkeep

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
# Node & Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/
