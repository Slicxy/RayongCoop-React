APP_NAME="RayongCoop Digital Portal"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/rayongcoop/public
APP_TIMEZONE=Asia/Bangkok
APP_KEY=base64:9pWq8uG7sR3tY2vX1zL5kN4jM8hP0oI6eU7aQ1wE3yT=

# Initial administrator bootstrap. Set a unique value of at least 16 characters
# in your untracked .env before running `php bin/console db:seed`.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@rayongcoop.com
INITIAL_ADMIN_PASSWORD=

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rayongcoop_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Security
SESSION_LIFETIME=7200
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# 2FA Settings
TWO_FACTOR_ISSUER="RayongCoop"
TWO_FACTOR_WINDOW=1

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=900

# Mail Configuration (Optional / Phase 6)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@rayongcoop.com"
MAIL_FROM_NAME="Rayong Public Health Cooperative"
